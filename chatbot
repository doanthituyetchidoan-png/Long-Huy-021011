GENERAL_TIPS = (
    "Mình là chatbot hỗ trợ học tập lớp 10. Bạn có thể hỏi về Toán, Lý, Hóa, Sinh, Văn, Anh, Sử hoặc Địa.\n"
    "Hỏi cụ thể hơn nếu bạn muốn ví dụ bài tập, lý thuyết, hay mẹo làm bài."
)


def normalize(text: str) -> str:
    return re.sub(r"[^a-z0-9áàạảãâấầậẩẫăắằặẳẵéèẹẻẽêếềệểễíìịỉĩóòọỏõôốồộổỗơớờợởỡúùụủũưứừựửữýỳỵỷỹđ]+", " ", text.lower())


def detect_subject(question: str) -> str | None:
    normalized = normalize(question)
    for subject, keywords in SUBJECT_KEYWORDS.items():
        for keyword in keywords:
            if keyword in normalized:
                return subject
    return None


def choose_answer(subject: str) -> str:
    answers = KNOWLEDGE.get(subject)
    if not answers:
        return random.choice([
            "Môn này mình chưa có nhiều nội dung lắm, bạn thử hỏi chi tiết hơn nhé.",
            "Mình chưa rõ môn đó lắm, bạn nói rõ hơn một chút được không?",
        ])

    fact = random.choice(answers)
    replies = [
        f"Được, mình chia sẻ chút nhé: {fact}",
        f"À, về phần đó thì {fact.lower()}",
        f"Mình thấy nội dung này hay: {fact}",
        f"Bạn nên biết rằng {fact.lower()}",
    ]
    return random.choice(replies)


def answer_question(question: str) -> str:
    subject = detect_subject(question)
    if subject:
        return choose_answer(subject)

    normalized = normalize(question)
    if any(word in normalized for word in ["help", "gợi ý", "cách", "giúp", "hướng dẫn"]):
        return GENERAL_TIPS

    return (
        "Mình chưa rõ câu hỏi. Bạn thử hỏi lại với từ khóa như 'Toán', 'Vật lý', 'Hóa', 'Văn', 'Tiếng Anh', 'Lịch sử' hoặc 'Địa lý' nhé."
    )


def main() -> None:
    print("=== Chatbot Học Tập Lớp 10 ===")
    print("Chào bạn! Mình có thể trợ giúp các môn Toán, Lý, Hóa, Sinh, Văn, Anh, Sử, Địa.")
    print("Gõ 'thoát' hoặc 'exit' để kết thúc.")

    while True:
        try:
            question = input("Bạn: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nTạm biệt! Chúc bạn học tốt.")
            break

        if not question:
            continue

        if question.lower() in {"thoát", "exit", "bye", "tạm biệt"}:
            print("Chatbot: Tạm biệt! Chúc bạn học tốt và ôn tập hiệu quả.")
            break

        answer = answer_question(question)
        print(f"Chatbot: {answer}\n")


if __name__ == "__main__":
    main()!/

